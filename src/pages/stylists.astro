---
/**
 * Stylists: photo, bio and "book me for…" for each, from `STYLISTS` in
 * `src/content/site.ts` (photos: `STYLIST_PHOTOS` in `src/lib/photos.ts`).
 * Each links to the booking page with that stylist chosen.
 */
import {Picture} from 'astro:assets';

import {BOOK, STYLISTS, STYLISTS_PAGE} from '../content/site';
import Base from '../layouts/Base.astro';
import {PHOTOS, STYLIST_PHOTOS} from '../lib/photos';
---

<Base title={STYLISTS_PAGE.title} description="Meet Maya, Theo, Lena and Rosa: who does what at Juniper Hair Studio, and who to book for cuts, colour, curls or a wedding.">
  <section class="wrap page-head">
    <h1>{STYLISTS_PAGE.title}</h1>
    <p class="lead">{STYLISTS_PAGE.lede}</p>
  </section>

  <section class="wrap guide" aria-labelledby="guide-title">
    <h2 id="guide-title" class="visually-hidden">Who to book for what</h2>
    <dl class="guide-list">
      {
        STYLISTS.map(s => (
          <div>
            <dt>{s.bestFor[0]}</dt>
            <dd>
              <a href={`#${s.id}`}>{s.name.split(' ')[0]}</a>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section" aria-label="The team">
    <div class="wrap people">
      {
        STYLISTS.map((s, i) => {
          const photo = STYLIST_PHOTOS[s.id];
          return (
            <article id={s.id} class="person" aria-labelledby={`${s.id}-name`}>
              <div class="frame person-photo">
                {photo && (
                  <Picture
                    src={photo.src}
                    alt={photo.alt}
                    widths={[320, 560, 900]}
                    sizes="(min-width: 1240px) 280px, (min-width: 760px) 40vw, calc(100vw - 32px)"
                    formats={['avif', 'webp']}
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                )}
              </div>
              <div class="person-text">
                <p class="eyebrow">{s.role}</p>
                <h2 id={`${s.id}-name`}>{s.name}</h2>
                <p class="small muted">{s.since}</p>
                <p>{s.bio}</p>
                <h3 class="label">Book {s.name.split(' ')[0]} for</h3>
                <ul class="best-for">
                  {s.bestFor.map(b => <li>{b}</li>)}
                </ul>
                <a class="btn btn-primary" href={`${BOOK.href}?stylist=${s.id}`}>
                  Book with {s.name.split(' ')[0]}
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="section band" aria-labelledby="unsure-title">
    <div class="wrap unsure">
      <div class="frame unsure-photo">
        <Picture src={PHOTOS.team.src} alt={PHOTOS.team.alt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 560px, calc(100vw - 32px)" formats={['avif', 'webp']} />
      </div>
      <div>
        <h2 id="unsure-title">Not sure who to pick?</h2>
        <p class="lead">Book “first available” and tell us a little about your hair. We will match you with the right person and text to confirm.</p>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={`${BOOK.href}?stylist=any`}>Book first available</a>
          <a class="btn btn-secondary btn-lg" href="/services/">See services & prices</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px 32px;
    margin: 0;
  }

  .guide-list div {
    border-top: 2px solid var(--ink);
    padding-top: 14px;
  }

  .guide-list dt {
    color: var(--ink-muted);
    font-size: 14px;
  }

  .guide-list dd {
    margin: 4px 0 0;
    font-size: 19px;
    font-weight: 700;
  }

  .guide-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .people {
    display: grid;
    gap: 64px 32px;
  }

  @media (min-width: 1000px) {
    .people {
      grid-template-columns: 1fr 1fr;
    }
  }

  .person {
    display: grid;
    gap: 24px 32px;
    scroll-margin-top: 88px;
  }

  @media (min-width: 640px) {
    .person {
      grid-template-columns: minmax(200px, 0.85fr) 1fr;
      align-items: start;
    }
  }

  .person-photo {
    aspect-ratio: 4 / 5;
    box-shadow: none;
  }

  .person-text h2 {
    margin-bottom: 6px;
    font-size: clamp(32px, 3.6vw, 40px);
    letter-spacing: -0.045em;
  }

  .person-text .eyebrow {
    margin-bottom: 10px;
  }

  .person-text h3 {
    margin: 20px 0 8px;
  }

  .best-for {
    margin: 0 0 24px;
    padding-inline-start: 20px;
  }

  .best-for li + li {
    margin-top: 4px;
  }

  .unsure {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
  }

  .unsure > div:last-child {
    flex: 1 1 420px;
  }

  .unsure-photo {
    flex: 1 1 400px;
    aspect-ratio: 3 / 2;
  }

  .unsure .lead {
    margin-top: 20px;
  }
</style>
