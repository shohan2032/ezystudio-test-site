---
/**
 * Gift cards: amounts, ways to buy and terms from `GIFT_CARDS` in
 * `src/content/site.ts`. A static site cannot take a payment, so the form
 * emails the request (src/scripts/mail-form.ts) and the salon takes payment
 * by phone. Selling online needs the Astro app template.
 */
import {Picture} from 'astro:assets';

import {CONTACT, GIFT_CARDS} from '../content/site';
import Base from '../layouts/Base.astro';
import {PHOTOS} from '../lib/photos';
---

<Base title={GIFT_CARDS.title} description="Give an afternoon of being looked after: Juniper Hair Studio gift cards from $25, for any service, stylist or product.">
  <section class="wrap page-head gift-head">
    <div>
      <h1>{GIFT_CARDS.title}</h1>
      <p class="lead">{GIFT_CARDS.lede}</p>
      <ul class="amounts" role="list" aria-label="Gift card amounts">
        {GIFT_CARDS.amounts.map(a => <li>{a}</li>)}
      </ul>
      <p class="muted">{GIFT_CARDS.custom}</p>
    </div>
    <div class="frame gift-photo">
      <Picture src={PHOTOS.gift.src} alt={PHOTOS.gift.alt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 520px, calc(100vw - 32px)" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section class="section band" aria-labelledby="ways-title">
    <div class="wrap">
      <h2 id="ways-title">Three ways to buy one</h2>
      <div class="cols ways">
        {
          GIFT_CARDS.ways.map(way => (
            <div class="ruled">
              <h3>{way.title}</h3>
              <p>{way.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="request-title">
    <div class="wrap gift-layout">
      <div>
        <h2 id="request-title">Request a gift card</h2>
        <p class="lead">Tell us who it is for. We reply within a day to take payment over the phone, then send the card.</p>
        <h3 class="terms-title">The small print</h3>
        <ul class="terms">
          {GIFT_CARDS.terms.map(t => <li>{t}</li>)}
        </ul>
        <p>Prefer to call? <a href={CONTACT.phoneHref}>{CONTACT.phone}</a></p>
      </div>

      <form
        class="card gift-form"
        data-mail-form
        data-subject="Gift card request"
        data-sent="Your email app should now open with your request filled in. Press send, and we will call you within a day to take payment."
        action={`mailto:${CONTACT.email}?subject=Gift%20card%20request`}
        method="post"
        enctype="text/plain"
        novalidate
      >
        <div class="field">
          <label for="amount">Amount</label>
          <select id="amount" name="amount" class="input" data-label="Amount" required aria-describedby="amount-error">
            <option value="">Choose an amount…</option>
            {GIFT_CARDS.amounts.map(a => <option>{a}</option>)}
            <option>Another amount (in the message)</option>
          </select>
          <p class="error" id="amount-error" data-missing="Choose an amount." hidden></p>
        </div>
        <div class="field">
          <label for="delivery">How should it arrive?</label>
          <select id="delivery" name="delivery" class="input" data-label="Delivery">
            <option>Emailed to me to print or forward</option>
            <option>Emailed straight to them</option>
            <option>Posted in a linen envelope</option>
            <option>I will collect it from the studio</option>
          </select>
        </div>
        <div class="field">
          <label for="for">Who is it for?</label>
          <input id="for" name="for" type="text" class="input" data-label="For" required aria-describedby="for-error" />
          <p class="error" id="for-error" data-missing="Tell us who the card is for." hidden></p>
        </div>
        <div class="field">
          <label for="message">A message for the card <span class="muted">(optional)</span></label>
          <textarea id="message" name="message" class="input" data-label="Message" placeholder="Happy birthday, treat yourself!"></textarea>
        </div>
        <div class="field">
          <label for="from">Your name</label>
          <input id="from" name="from" type="text" class="input" autocomplete="name" data-label="From" required aria-describedby="from-error" />
          <p class="error" id="from-error" data-missing="Tell us your name." hidden></p>
        </div>
        <div class="field">
          <label for="phone">Your phone</label>
          <input id="phone" name="phone" type="tel" class="input" autocomplete="tel" data-label="Phone" required aria-describedby="phone-hint phone-error" />
          <p class="hint" id="phone-hint">So we can call to take payment.</p>
          <p class="error" id="phone-error" data-missing="Add a phone number so we can take payment." data-format="That number looks too short." hidden></p>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">Send gift card request</button>
        <p class="form-status" role="status" data-status></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import {setUpMailForms} from '../scripts/mail-form';

  document.addEventListener('astro:page-load', setUpMailForms);
</script>

<style>
  .gift-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
  }

  .gift-head > div:first-child {
    flex: 1 1 480px;
  }

  .gift-photo {
    flex: 1 1 380px;
    aspect-ratio: 4 / 3;
  }

  .amounts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 32px 0 8px;
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-size: clamp(40px, 5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .ways {
    margin-top: 48px;
  }

  .gift-layout {
    display: grid;
    gap: 48px 64px;
  }

  @media (min-width: 960px) {
    .gift-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .gift-layout .lead {
    margin-top: 20px;
  }

  .terms-title {
    margin-top: 40px;
  }

  .terms {
    padding-inline-start: 20px;
  }

  .gift-form {
    display: grid;
    gap: 20px;
    padding: 24px;
    border-radius: 20px;
  }

  @media (min-width: 640px) {
    .gift-form {
      padding: 32px;
    }
  }

  .gift-form .btn {
    justify-self: start;
  }
</style>
