---
/**
 * Services: every service with its length and price, grouped, from
 * `SERVICES` in `src/content/site.ts`. Each one links to the booking page
 * with the service already chosen (`/book/?service=<id>`).
 */
import {Picture} from 'astro:assets';

import {BOOK, POLICY, SERVICES, SERVICES_PAGE} from '../content/site';
import Base from '../layouts/Base.astro';
import {PHOTOS} from '../lib/photos';
---

<Base title={SERVICES_PAGE.title} description="Every cut, colour, treatment and wedding service at Juniper Hair Studio, with how long each takes and what it costs.">
  <section class="wrap page-head">
    <h1>{SERVICES_PAGE.title}</h1>
    <p class="lead">{SERVICES_PAGE.lede}</p>
    <nav aria-label="Service groups">
      <ul class="chips">
        {SERVICES.map(group => <li><a class="chip" href={`#${group.id}`}>{group.title}</a></li>)}
      </ul>
    </nav>
  </section>

  {
    SERVICES.map((group, i) => (
      <section id={group.id} class:list={['section', 'group', {band: i % 2 === 0}]} aria-labelledby={`${group.id}-title`}>
        <div class="wrap group-inner">
          <div class="group-head">
            <h2 id={`${group.id}-title`}>{group.title}</h2>
            <p>{group.intro}</p>
          </div>
          <ul class="price-list" role="list">
            {group.items.map(item => (
              <li class="price-row">
                <div class="price-main">
                  <h3>{item.name}</h3>
                  <p>{item.body}</p>
                </div>
                <div class="price-meta">
                  <span class="price">{item.price}</span>
                  <span class="small muted">{item.length}</span>
                </div>
                <a class="btn btn-secondary book-link" href={`${BOOK.href}?service=${item.id}`}>
                  Book<span class="visually-hidden"> {item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section" aria-labelledby="policy-title">
    <div class="wrap policy">
      <div class="frame policy-image">
        <Picture src={PHOTOS.tools.src} alt={PHOTOS.tools.alt} widths={[400, 700, 1100]} sizes="(min-width: 1000px) 540px, calc(100vw - 32px)" formats={['avif', 'webp']} />
      </div>
      <div>
        <h2 id="policy-title">Deposits & cancellations</h2>
        <ul class="ticks">
          {POLICY.points.map(point => <li>{point}</li>)}
        </ul>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={BOOK.href}>{BOOK.label}</a>
          <a class="btn btn-secondary btn-lg" href="/stylists/">Choose a stylist</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .group {
    scroll-margin-top: 68px;
  }

  .group-inner {
    display: grid;
    gap: 32px 64px;
  }

  @media (min-width: 960px) {
    .group-inner {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
  }

  .group-head h2 {
    font-size: clamp(32px, 3.6vw, 46px);
    letter-spacing: -0.045em;
  }

  .price-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .price-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .price-main h3 {
    margin-bottom: 4px;
    font-size: 19px;
  }

  .price-main p {
    margin: 0;
  }

  .price-meta {
    display: grid;
    justify-items: end;
    align-content: start;
    text-align: end;
  }

  .price {
    color: var(--ink);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .book-link {
    grid-column: 1 / -1;
    justify-self: start;
    min-height: 40px;
  }

  @media (min-width: 640px) {
    .price-row {
      grid-template-columns: 1fr auto auto;
      align-items: center;
    }

    .book-link {
      grid-column: auto;
    }
  }

  .policy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
  }

  .policy > div:last-child {
    flex: 1 1 420px;
  }

  .policy-image {
    flex: 1 1 400px;
    aspect-ratio: 4 / 3;
  }

  .ticks {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-block: 12px;
    padding-inline-start: 32px;
    border-bottom: 1px solid var(--line);
  }

  .ticks li::before {
    content: '';
    position: absolute;
    inset-inline-start: 4px;
    top: 18px;
    width: 12px;
    height: 7px;
    border-inline-start: 2px solid var(--primary);
    border-bottom: 2px solid var(--primary);
    transform: rotate(-45deg);
  }
</style>
