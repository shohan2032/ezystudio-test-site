---
/** Built as `404.html` at the root: the platform answers every missing path with it. */
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="wrap narrow section center">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist</h1>
    <p class="lede">The link may be old, or the address mistyped.</p>
    <div class="actions">
      <a class="button" href="/">Go to the home page</a>
      <a class="button ghost" href="/blog/">Read the blog</a>
    </div>
  </section>
</Base>
