---
/**
 * The home page: PRERENDERED, photographs first (Hallmark "Photographic").
 * Words in `src/content/site.ts`. Today's specials are filled in by the
 * browser from `/site-api/specials` (staff edit them in `/portal/specials`);
 * the latest news comes from `src/content/blog/` at build time.
 */
import Photo from '../components/Photo.astro';
import {HOME, PHOTOS, photo, RESTAURANT, REVIEWS} from '../content/site';
import Base from '../layouts/Base.astro';
import {MAX_PARTY} from '../lib/booking';
import {formatDate, postHref, publishedPosts} from '../lib/posts';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const latest = (await publishedPosts()).slice(0, 3);
const [lead, ...more] = REVIEWS;
---

<Base site={site} viewer={viewer} isStatic image={photo(PHOTOS.hero.src, 1200, 630)} imageAlt={PHOTOS.hero.alt}>
  <main id="main" tabindex="-1">
    <section class="fold" aria-labelledby="home-title">
      <Photo photo={PHOTOS.hero} sizes="100vw" widths={[640, 1024, 1600, 2200]} eager />
      <div class="fold-text">
        <p class="fold-caption">{PHOTOS.hero.caption}</p>
        <h1 id="home-title">A wood-fire kitchen on Stokes Croft</h1>
        <div class="fold-actions">
          <a class="btn" href="/book/" data-astro-prefetch>Book a table</a>
          <a class="link-arrow" href="/menu/" data-astro-prefetch>See the menu</a>
        </div>
      </div>
    </section>

    <section class="band shell" aria-label="Our story">
      <div class="band-split">
        <div>
          <p class="band-statement">{HOME.story}</p>
          <p class="prose">{HOME.storyMore}</p>
          <a class="link-arrow" href="/about/" data-astro-prefetch>Our story</a>
        </div>
        <dl class="hours" aria-label="At a glance">
          <dt>Dinner</dt>
          <dd>Wednesday – Saturday</dd>
          <dt>Lunch</dt>
          <dd>Friday – Sunday</dd>
          <dt>Tables</dt>
          <dd>Up to {MAX_PARTY}, or the whole room</dd>
          <dt>Walk-ins</dt>
          <dd>Always a few seats at the bar</dd>
        </dl>
      </div>
    </section>

    <section class="band-tight shell" aria-labelledby="specials-title" data-specials>
      <div class="board">
        <figure class="board-photo">
          <Photo photo={PHOTOS.fire} sizes="(min-width: 52rem) 40vw, 100vw" ratio={1.25} widths={[480, 720, 960]} />
        </figure>
        <div>
          <div class="board-head">
            <h2 id="specials-title">Today’s specials</h2>
            <p class="board-date" data-today>Chalked up every afternoon at four.</p>
          </div>
          <p class="board-empty" data-state="loading">Reading the board…</p>
          <ul class="dish-list" data-list hidden></ul>
          <p class="board-empty" data-state="empty" hidden>
            The board is being written. Ask at the table — or see the full menu, which changes every Thursday.
          </p>
          <p class="board-empty" data-state="error" hidden>
            We could not load the board just now. The full menu is always on the <a href="/menu/">menu page</a>.
          </p>
          <p><a class="link-arrow" href="/menu/" data-astro-prefetch>The full menu</a></p>
        </div>
      </div>
    </section>

    <section class="fold fold-short" aria-labelledby="share-title">
      <Photo photo={PHOTOS.table} sizes="100vw" widths={[640, 1024, 1600, 2200]} />
      <div class="fold-text">
        <p class="fold-caption">Plates for the middle</p>
        <h2 id="share-title">Order a few, pass them round</h2>
        <div class="fold-actions">
          <a class="link-arrow" href="/events/" data-astro-prefetch>Groups &amp; private dining</a>
        </div>
      </div>
    </section>

    <section class="band shell" aria-labelledby="reviews-title">
      <div class="section-head">
        <h2 id="reviews-title">What people say</h2>
      </div>
      <div class="reviews">
        {
          lead && (
            <figure class="review review-lead">
              <blockquote>
                <p>“{lead.quote}”</p>
              </blockquote>
              <figcaption>
                — {lead.author}, {lead.source}
                {lead.sample && <span class="sample-tag">Sample review</span>}
              </figcaption>
            </figure>
          )
        }
        <div class="reviews-more">
          {
            more.map(review => (
              <figure class="review">
                <blockquote>
                  <p>“{review.quote}”</p>
                </blockquote>
                <figcaption>
                  — {review.author}, {review.source}
                  {review.sample && <span class="sample-tag">Sample review</span>}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    {
      latest.length > 0 && (
        <section class="band-tight shell" aria-labelledby="news-title">
          <div class="section-head">
            <h2 id="news-title">News from the kitchen</h2>
            <a class="link-arrow" href="/news/" data-astro-prefetch>All news</a>
          </div>
          <ul class="news-list">
            {latest.map(post => (
              <li>
                <a href={postHref(post)} data-astro-prefetch>
                  <h3>{post.data.title}</h3>
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="closing" aria-labelledby="closing-title">
      <div class="shell closing-inner">
        <div>
          <h2 id="closing-title">Come and eat with us</h2>
          <p>Book online for up to {MAX_PARTY}, or call — we pick up from noon, Wednesday to Sunday.</p>
        </div>
        <div class="closing-actions">
          <a class="btn" href="/book/" data-astro-prefetch>Book a table</a>
          <a class="link-arrow" href={RESTAURANT.phoneHref}>Call {RESTAURANT.phone}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import {formatDay, londonToday} from '../lib/booking';
  import {fillSpecials} from '../lib/specials-board';

  // Runs on every `astro:page-load` (ClientRouter) while this is the page.
  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector<HTMLElement>('[data-specials]');
    if (!section) return;
    const today = section.querySelector<HTMLElement>('[data-today]');
    if (today) today.textContent = `${formatDay(londonToday(new Date()))} · chalked up at four`;
    void fillSpecials(section);
  });
</script>
