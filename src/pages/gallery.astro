---
/**
 * Gallery: the photos in `GALLERY` (src/lib/photos.ts), in order. Add a photo:
 * put it in `src/assets/salon/`, import it there and add a line to `GALLERY`.
 */
import {Picture} from 'astro:assets';

import {BOOK, GALLERY_PAGE} from '../content/site';
import Base from '../layouts/Base.astro';
import {GALLERY} from '../lib/photos';
---

<Base title={GALLERY_PAGE.title} description="Balayage, bobs, curly cuts and vivid colour: a gallery of recent work from Juniper Hair Studio in Portland.">
  <section class="wrap page-head">
    <h1>{GALLERY_PAGE.title}</h1>
    <p class="lead">{GALLERY_PAGE.lede}</p>
  </section>

  <section class="wrap gallery-section" aria-label="Photos">
    <ul class="gallery" role="list">
      {
        GALLERY.map((photo, i) => (
          <li class:list={{tall: photo.tall}}>
            <figure>
              <div class="frame shot">
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  widths={[360, 640, 960]}
                  sizes="(min-width: 1240px) 390px, (min-width: 700px) 45vw, calc(100vw - 32px)"
                  formats={['avif', 'webp']}
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
              </div>
              <figcaption class="small muted">{photo.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section dark cta-band" aria-labelledby="cta-title">
    <div class="wrap">
      <div>
        <h2 id="cta-title">Seen something you love?</h2>
        <p class="lead">Bring a screenshot to your appointment, or mention it when you book. We will tell you honestly what will suit your hair.</p>
      </div>
      <div class="actions">
        <a class="btn btn-on-dark btn-lg" href={BOOK.href}>{BOOK.label}</a>
        <a class="btn btn-outline-dark btn-lg" href="/stylists/">Meet the stylists</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .gallery-section {
    padding-bottom: var(--section);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    grid-auto-rows: 320px;
    grid-auto-flow: dense;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery li.tall {
    grid-row: span 2;
  }

  .gallery figure {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
  }

  .shot {
    flex: 1;
    min-height: 0;
    box-shadow: none;
  }

  .gallery figcaption {
    margin-top: 10px;
  }
</style>
