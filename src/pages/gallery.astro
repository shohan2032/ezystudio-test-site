---
/** The gallery: PRERENDERED. Photos and captions in `src/content/site.ts` (`GALLERY`). */
import Photo from '../components/Photo.astro';
import {GALLERY, RESTAURANT} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
---

<Base site={site} viewer={viewer} isStatic title="Gallery" description="Photographs from the dining room, the bar and the wood fire at Fennel & Fig on Stokes Croft, Bristol.">
  <main id="main" tabindex="-1">
    <header class="page-head shell">
      <h1>Gallery</h1>
      <p class="lede-lg">The room, the fire, and a few of the plates that come off it. More every week on <a href={RESTAURANT.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>.</p>
    </header>

    <div class="shell band-tight">
      <ul class="gallery">
        {
          GALLERY.map((item, i) => (
            <li>
              <figure>
                <Photo
                  photo={item}
                  sizes={i % 6 === 0 ? '(min-width: 52rem) 66vw, 100vw' : '(min-width: 52rem) 33vw, 50vw'}
                  ratio={i % 6 === 0 ? 0.75 : 0.8}
                  widths={[400, 720, 1200]}
                  eager={i === 0}
                />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            </li>
          ))
        }
      </ul>
    </div>

    <section class="closing" aria-labelledby="gallery-book-title">
      <div class="shell closing-inner">
        <div>
          <h2 id="gallery-book-title">Better in person</h2>
          <p>Lunch Friday to Sunday, dinner Wednesday to Saturday.</p>
        </div>
        <div class="closing-actions">
          <a class="btn" href="/book/" data-astro-prefetch>Book a table</a>
        </div>
      </div>
    </section>
  </main>
</Base>
