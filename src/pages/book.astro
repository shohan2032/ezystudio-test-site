---
/**
 * Book a table: PRERENDERED; the form posts to `/site-api/bookings`. The
 * times for the chosen day come from `/site-api/bookings/slots` (full slots
 * are shown but disabled). Rules in `src/lib/booking.ts`, shared with the
 * server. Staff confirm requests in `/portal/bookings`; a signed-in guest sees
 * theirs in `/portal/bookings/mine`.
 */
import Photo from '../components/Photo.astro';
import {BOOK, PHOTOS, RESTAURANT} from '../content/site';
import Base from '../layouts/Base.astro';
import {hoursRows, LIMITS, MAX_PARTY} from '../lib/booking';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const sizes = Array.from({length: MAX_PARTY}, (_, i) => i + 1);
---

<Base site={site} viewer={viewer} isStatic title={BOOK.title} description="Book a table at Fennel & Fig on Stokes Croft, Bristol: lunch Friday to Sunday, dinner Wednesday to Saturday, for up to eight.">
  <main id="main" tabindex="-1">
    <header class="page-head shell">
      <h1>{BOOK.title}</h1>
      <p class="lede-lg">{BOOK.lede}</p>
    </header>

    <div class="shell band-tight">
      <div class="form-layout">
        <div>
          <form id="booking-form" class="site-form" novalidate>
            <fieldset>
              <legend>When</legend>
              <div class="row">
                <div class="field">
                  <label for="bk-date">Date</label>
                  <input id="bk-date" name="date" type="date" />
                </div>
                <div class="field">
                  <label for="bk-party">People</label>
                  <select id="bk-party" name="partySize">
                    {sizes.map(n => <option value={String(n)} selected={n === 2}>{n === 1 ? '1 person' : `${n} people`}</option>)}
                  </select>
                  <p class="field-hint" id="bk-party-hint">Nine or more? <a href="/events/#enquire">Send a group enquiry</a>.</p>
                </div>
                <div class="field">
                  <label for="bk-time">Time</label>
                  <select id="bk-time" name="time" disabled aria-describedby="bk-time-hint" data-describedby="bk-time-hint">
                    <option value="">Choose a date first</option>
                  </select>
                  <p class="field-hint" id="bk-time-hint" aria-live="polite">Times appear once you pick a day.</p>
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend>Who</legend>
              <div class="row">
                <div class="field">
                  <label for="bk-name">Name for the booking</label>
                  <input id="bk-name" name="name" autocomplete="name" maxlength={LIMITS.name} />
                </div>
                <div class="field">
                  <label for="bk-phone">Phone</label>
                  <input id="bk-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="07700 900123" />
                </div>
              </div>
              <div class="field">
                <label for="bk-email">Email</label>
                <input id="bk-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="name@example.com" />
                <p class="field-hint" id="bk-email-hint">We send the confirmation here. Nothing else.</p>
              </div>
              <div class="field">
                <label for="bk-notes">Anything we should know? <span class="optional">(optional)</span></label>
                <textarea id="bk-notes" name="notes" rows="3" placeholder="An allergy, a birthday, a high chair, a table near the door…"></textarea>
              </div>
            </fieldset>

            <p class="notice" data-form-status hidden></p>
            <p class="muted small" data-guest-only>
              Have an account? <a href="/account/login/?next=%2Fbook%2F">Sign in</a> first to see your bookings in your dashboard.
            </p>
            <p class="muted small" data-user-only hidden>You’re signed in: this booking will also appear in your dashboard.</p>
            <div>
              <button class="btn" type="submit">Request this table</button>
            </div>
          </form>
        </div>

        <aside class="form-aside" aria-label="Before you book">
          <div>
            <h2>How booking works</h2>
            <ul>
              {BOOK.policy.map(line => <li>{line}</li>)}
            </ul>
          </div>
          <div>
            <h2>Opening hours</h2>
            <dl class="hours">
              {
                hoursRows().map(row => (
                  <>
                    <dt>{row.days}</dt>
                    <dd>{row.times}</dd>
                  </>
                ))
              }
            </dl>
          </div>
          <div>
            <h2>Prefer to call?</h2>
            <p><a href={RESTAURANT.phoneHref}>{RESTAURANT.phone}</a>, from noon on the days we’re open.</p>
          </div>
          <figure>
            <Photo photo={PHOTOS.friends} sizes="(min-width: 52rem) 30vw, 100vw" ratio={0.75} widths={[400, 720, 1000]} />
          </figure>
        </aside>
      </div>
    </div>
  </main>
</Base>

<script>
  import {addDays, BOOK_AHEAD_DAYS, checkBooking, formatDay, formatTime, londonToday, openSlots, slotsFor, WEEKDAYS, weekdayOf} from '../lib/booking';
  import {bindForm, postJson, rulesFromCheck} from '../lib/form';
  import type {OwnBooking} from '../lib/types';
  import {siteFetch} from '../platform/browser';

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#booking-form');
    if (!form) return;
    const date = form.querySelector<HTMLInputElement>('#bk-date')!;
    const time = form.querySelector<HTMLSelectElement>('#bk-time')!;
    const party = form.querySelector<HTMLSelectElement>('#bk-party')!;
    const hint = form.querySelector<HTMLElement>('#bk-time-hint')!;

    const today = londonToday(new Date());
    date.min = today;
    date.max = addDays(today, BOOK_AHEAD_DAYS);

    // `?date=` from a link (e.g. "Book for Sunday lunch") is a starting point only.
    const asked = new URL(window.location.href).searchParams.get('date');
    if (asked && /^\d{4}-\d{2}-\d{2}$/.test(asked)) date.value = asked;

    let free = new Map<string, number>();
    let request = 0;

    const option = (value: string, label: string, disabled = false) => {
      const node = document.createElement('option');
      node.value = value;
      node.textContent = label;
      node.disabled = disabled;
      return node;
    };

    /** Rebuild the time list for the chosen day and party size, keeping the choice when it still fits. */
    const renderTimes = (times: string[]) => {
      const keep = time.value;
      const size = Number(party.value) || 1;
      const options = [option('', times.length ? 'Choose a time' : 'No times left')];
      let any = false;
      for (const slot of times) {
        const left = free.get(slot);
        const full = left !== undefined && left < size;
        if (!full) any = true;
        options.push(option(slot, full ? `${formatTime(slot)} — full` : formatTime(slot), full));
      }
      time.replaceChildren(...options);
      time.disabled = times.length === 0;
      if (keep && times.includes(keep) && !(free.get(keep)! < size)) time.value = keep;
      hint.textContent = !times.length
        ? 'Nothing left that day. Try another, or call us for the waiting list.'
        : any
          ? `${formatDay(date.value)}. Lunch and dinner times shown.`
          : 'Fully booked for a party this size. Try another day, or call us.';
    };

    const loadTimes = async () => {
      const day = date.value;
      free = new Map();
      if (!day) {
        time.replaceChildren(option('', 'Choose a date first'));
        time.disabled = true;
        hint.textContent = 'Times appear once you pick a day.';
        return;
      }
      if (!slotsFor(day).length) {
        time.replaceChildren(option('', 'Closed that day'));
        time.disabled = true;
        hint.textContent = `We’re closed on ${WEEKDAYS[weekdayOf(day)]}s. Choose another day.`;
        return;
      }
      const mine = ++request;
      time.disabled = true;
      time.replaceChildren(option('', 'Finding times…'));
      hint.textContent = 'Checking the diary…';
      try {
        const res = await siteFetch(`/site-api/bookings/slots?date=${encodeURIComponent(day)}`, {headers: {accept: 'application/json'}});
        if (mine !== request) return;
        if (!res.ok) throw new Error('slots');
        const data = (await res.json()) as {slots: {time: string; free: number}[]};
        free = new Map(data.slots.map(slot => [slot.time, slot.free]));
        renderTimes(data.slots.map(slot => slot.time));
      } catch {
        if (mine !== request) return;
        // The diary did not answer: offer the opening times; the server still checks space.
        renderTimes(openSlots(day, new Date()));
        hint.textContent = 'We could not check the diary just now; we will tell you if your time is taken.';
      }
    };

    date.addEventListener('change', () => void loadTimes());
    party.addEventListener('change', () => {
      if (free.size) renderTimes([...free.keys()]);
    });
    if (date.value) void loadTimes();

    bindForm(form, {
      // The server's own check, field by field (src/lib/booking.ts).
      rules: rulesFromCheck(form, ['date', 'time', 'partySize', 'name', 'phone', 'email', 'notes'], values =>
        checkBooking(values, new Date())
      ),
      pendingLabel: 'Sending your request…',
      async submit(values) {
        const {data, result} = await postJson(siteFetch, '/site-api/bookings', values);
        if (result.ok) {
          const booking = (data as {booking?: OwnBooking} | null)?.booking;
          showConfirmation(form, booking, result.message);
        } else if (result.fields?.time) {
          // Someone took the last seats meanwhile: refresh the list.
          void loadTimes();
        }
        return result;
      },
    });
  });

  function showConfirmation(form: HTMLFormElement, booking: OwnBooking | undefined, message: string | undefined) {
    const box = document.createElement('div');
    box.className = 'confirmation';
    box.setAttribute('role', 'status');
    box.tabIndex = -1;
    const add = (tag: 'h2' | 'p', text: string, className = '') => {
      const node = document.createElement(tag);
      node.textContent = text;
      if (className) node.className = className;
      box.append(node);
      return node;
    };
    add('h2', 'Request received');
    if (booking) {
      add('p', `${formatDay(booking.date)} at ${formatTime(booking.time)}, ${booking.partySize === 1 ? '1 person' : `${booking.partySize} people`}.`);
      add('p', `Your reference: ${booking.reference}`, 'ref');
    }
    add('p', message ?? 'We will confirm by email or phone, usually within a few hours.');
    add('p', 'Quote your reference if you call us to change anything.', 'muted');
    const back = document.createElement('a');
    back.className = 'link-arrow';
    back.href = '/menu/';
    back.textContent = 'Have a look at the menu';
    box.append(back);
    form.replaceWith(box);
    box.focus();
  }
</script>
