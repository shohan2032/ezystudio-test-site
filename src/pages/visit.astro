---
/**
 * Visit us: address, map, hours, phone. PRERENDERED. Details in
 * `src/content/site.ts` (`RESTAURANT`, `VISIT`); hours in `src/lib/booking.ts`.
 * The map is a pair of links out (Google Maps, OpenStreetMap): embedding a
 * map frame would need its host added to `frame-src` in astro.config.mjs.
 */
import Photo from '../components/Photo.astro';
import {PHOTOS, RESTAURANT, VISIT} from '../content/site';
import Base from '../layouts/Base.astro';
import {hoursRows} from '../lib/booking';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const {lat, lng} = RESTAURANT;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=18/${lat}/${lng}`;
---

<Base site={site} viewer={viewer} isStatic title="Visit us" description={`${RESTAURANT.name}, ${RESTAURANT.street}, ${RESTAURANT.city} ${RESTAURANT.postcode}. Opening hours, map, phone and how to get here.`}>
  <main id="main" tabindex="-1">
    <header class="page-head shell">
      <h1>{VISIT.title}</h1>
      <p class="lede-lg">{VISIT.lede}</p>
    </header>

    <div class="shell band-tight">
      <div class="visit-grid">
        <div class="visit-details">
          <div>
            <h2>Address</h2>
            <address>
              {RESTAURANT.name}<br />
              {RESTAURANT.street}<br />
              {RESTAURANT.city} {RESTAURANT.postcode}
            </address>
            <p><a class="link-arrow" href={directions} rel="noopener noreferrer" target="_blank">Get directions</a></p>
          </div>
          <div>
            <h2>Opening hours</h2>
            <dl class="hours">
              {
                hoursRows().map(row => (
                  <>
                    <dt>{row.days}</dt>
                    <dd>{row.times}</dd>
                  </>
                ))
              }
            </dl>
          </div>
          <div>
            <h2>Get in touch</h2>
            <p><a href={RESTAURANT.phoneHref}>{RESTAURANT.phone}</a></p>
            <p><a href={`mailto:${RESTAURANT.email}`}>{RESTAURANT.email}</a></p>
          </div>
          <div>
            <a class="btn" href="/book/" data-astro-prefetch>Book a table</a>
          </div>
        </div>
        <figure class="map">
          <Photo photo={PHOTOS.room} sizes="(min-width: 52rem) 55vw, 100vw" ratio={0.75} widths={[480, 800, 1200]} eager />
          <figcaption>
            Find us on a map:
            <a href={directions} rel="noopener noreferrer" target="_blank">Google Maps</a> ·
            <a href={osm} rel="noopener noreferrer" target="_blank">OpenStreetMap</a>
          </figcaption>
        </figure>
      </div>
    </div>

    <section class="band-tight shell" aria-labelledby="getting-here">
      <div class="section-head">
        <h2 id="getting-here">Getting here</h2>
      </div>
      <ul class="ways">
        {
          VISIT.gettingHere.map(way => (
            <li>
              <h3>{way.heading}</h3>
              <p>{way.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="fold fold-short band-gap" aria-labelledby="visit-night">
      <Photo photo={PHOTOS.bar} sizes="100vw" widths={[640, 1024, 1600, 2200]} />
      <div class="fold-text">
        <p class="fold-caption">No booking? Try the bar</p>
        <h2 id="visit-night">Walk-ins welcome, every night we’re open</h2>
      </div>
    </section>
  </main>
</Base>
