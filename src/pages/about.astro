---
/** Our story and team: PRERENDERED. Words in `src/content/site.ts` (`ABOUT`). */
import Photo from '../components/Photo.astro';
import {ABOUT, PHOTOS} from '../content/site';
import Base from '../layouts/Base.astro';
import {staticContext} from '../server/page';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const chapterPhotos = [PHOTOS.fire, PHOTOS.herbs];
---

<Base site={site} viewer={viewer} isStatic title="Our story" description={ABOUT.lede}>
  <main id="main" tabindex="-1">
    <section class="fold fold-short" aria-labelledby="about-title">
      <Photo photo={PHOTOS.hall} sizes="100vw" widths={[640, 1024, 1600, 2200]} eager />
      <div class="fold-text">
        <p class="fold-caption">41 Stokes Croft, since 2021</p>
        <h1 id="about-title">{ABOUT.title}</h1>
      </div>
    </section>

    <div class="shell">
      <p class="band-statement band-lede">{ABOUT.lede}</p>

      {
        ABOUT.chapters.map((chapter, i) => (
          <section class="chapter" aria-labelledby={`chapter-${i}`}>
            <div class="prose">
              <h2 id={`chapter-${i}`}>{chapter.heading}</h2>
              {chapter.body.map(paragraph => (
                <p>{paragraph}</p>
              ))}
            </div>
            <figure class="chapter-photo">
              <Photo photo={chapterPhotos[i % chapterPhotos.length]} sizes="(min-width: 52rem) 40vw, 100vw" ratio={0.75} widths={[480, 800, 1200]} />
            </figure>
          </section>
        ))
      }

      <section class="band-tight" aria-labelledby="team-title">
        <div class="section-head">
          <h2 id="team-title">Who you’ll meet</h2>
        </div>
        <ul class="team">
          {
            ABOUT.team.map((person, i) => (
              <li>
                <figure>
                  <Photo photo={person.photo} sizes="(min-width: 52rem) 33vw, 100vw" ratio={i === 0 ? 0.8 : 1.25} widths={[400, 720, 1000]} />
                </figure>
                <h3>{person.name}</h3>
                <p class="role">{person.role}</p>
                <p>{person.bio}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section class="closing" aria-labelledby="about-book-title">
      <div class="shell closing-inner">
        <div>
          <h2 id="about-book-title">Pull up a chair</h2>
          <p>The best way to know us is to eat with us.</p>
        </div>
        <div class="closing-actions">
          <a class="btn" href="/book/" data-astro-prefetch>Book a table</a>
          <a class="link-arrow" href="/jobs/">Work with us</a>
        </div>
      </div>
    </section>
  </main>
</Base>
