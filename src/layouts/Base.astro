---
/**
 * <head>, header and footer for every page. Pure HTML and CSS, and the
 * stylesheet is inlined (astro.config.mjs), so nothing blocks the first paint.
 * The only scripts are Astro's own, deferred modules from this host: prefetch
 * (`prefetch` in astro.config.mjs: a link the visitor points at is fetched
 * ahead) and client navigation (`<ClientRouter />`: a click swaps the next
 * page in without a reload and announces its title to screen readers). Every
 * page stays a real prerendered HTML file, so search sees the same pages.
 *
 * SEO for every page comes from the props: a unique `title` + `description`,
 * a canonical URL and `og:url` (when the site's address is known,
 * src/lib/site-url.ts), Open Graph + Twitter card tags, and links to the RSS
 * feed and the sitemap. Structured data (JSON-LD, src/lib/json-ld.ts): the
 * home page gets `WebSite` + `Organization`, a page passes its own in `jsonLd`
 * (a post's `BlogPosting`).
 */
import '../styles/global.css';

import {ClientRouter} from 'astro:transitions';

import {ADDRESS, BOOK, CONTACT, HOURS, NAV, SITE} from '../content/site';
import {type JsonLd, jsonLdText, siteJsonLd} from '../lib/json-ld';
import {absoluteUrl} from '../lib/site-url';

interface Props {
  /** The page's own name; the tab shows "<title> · <site>". Omit on home. */
  title?: string;
  /** The meta description (search results, social cards): ~150 characters. */
  description?: string;
  /** A social card image, 1200×630: a `/path` on this site or an https URL. */
  image?: string;
  /** Text for the social image (`og:image:alt`). */
  imageAlt?: string;
  /** `article` on a blog post (adds its dates), `website` elsewhere. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Keep this page out of search results (and the sitemap: src/pages/sitemap.xml.ts). */
  noindex?: boolean;
  /** The page's own structured data (src/lib/json-ld.ts), e.g. `postJsonLd(…)` on a post. */
  jsonLd?: JsonLd;
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt,
  type = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const path = Astro.url.pathname;
const canonical = noindex ? null : absoluteUrl(path);
const socialImage = image ? absoluteUrl(image) : null;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const time12 = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  return `${h % 12 || 12}${m ? `:${String(m).padStart(2, '0')}` : ''}${h < 12 ? 'am' : 'pm'}`;
};
// The home page tells search engines the site's name; other pages bring their own.
const structured = [...(path === '/' ? [siteJsonLd()] : []), ...(jsonLd && !noindex ? [jsonLd] : [])];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {structured.map(data => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="brand" aria-label={`${SITE.name}, home`}>{SITE.short}<span class="brand-dot" aria-hidden="true"></span></a>
        <nav class="site-nav" aria-label="Main">
          {
            NAV.map(item => (
              <a href={item.href} data-astro-prefetch="viewport" aria-current={active(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="btn btn-primary" href={BOOK.href} aria-current={active(BOOK.href) ? 'page' : undefined}>{BOOK.label}</a>
        <details class="menu">
          <summary class="btn btn-ghost" aria-label="Menu">
            <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
            Menu
          </summary>
          <nav class="menu-panel" aria-label="Main menu">
            <a href="/" aria-current={active('/') ? 'page' : undefined}>Home</a>
            {
              NAV.map(item => (
                <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href={BOOK.href} aria-current={active(BOOK.href) ? 'page' : undefined}>{BOOK.label}</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer-grid">
        <div>
          <p class="brand footer-brand">{SITE.short}<span class="brand-dot" aria-hidden="true"></span></p>
          <p>{SITE.name}. Cuts, colour and curls in the {ADDRESS.neighbourhood}.</p>
        </div>
        <nav aria-label="Footer">
          <h2>Pages</h2>
          <ul>
            <li><a href="/">Home</a></li>
            {NAV.map(item => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href={BOOK.href}>{BOOK.label}</a></li>
          </ul>
        </nav>
        <div>
          <h2>Find us</h2>
          <p>
            {ADDRESS.street}<br />{ADDRESS.city}
          </p>
          <ul>
            <li><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></li>
            <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          </ul>
        </div>
        <div>
          <h2>Opening hours</h2>
          <table class="hours">
            <tbody>
              {
                HOURS.map(h => (
                  <tr>
                    <th scope="row">{h.day.slice(0, 3)}</th>
                    <td>{h.open ? `${time12(h.open)} – ${time12(h.close)}` : 'Closed'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <div class="wrap site-footer-base">
        <span>© {new Date().getUTCFullYear()} {SITE.name}</span>
        <a href="/rss.xml">Journal RSS feed</a>
      </div>
    </footer>
  </body>
</html>
