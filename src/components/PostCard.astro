---
/** One post in a list. Fixed image box (no layout shift), lazy image unless `eager`. */
import {type BlogPost, formatDate, postHref} from '../lib/posts';
import Cover from './Cover.astro';

interface Props {
  post: BlogPost;
  /** The heading level inside the list: `h2` under a page's `<h1>`, `h3` under a section's `<h2>`. */
  as?: 'h2' | 'h3';
  /** Load the cover at once (cards above the fold). */
  eager?: boolean;
}

const {post, as: Heading = 'h3', eager = false} = Astro.props;
const {title, description, publishedAt, author, cover, coverAlt} = post.data;
---

<a class="post-card" href={postHref(post)}>
  {
    cover ? (
      <Cover class="cover" src={cover} alt={coverAlt} width={640} height={360} sizes="(min-width: 1100px) 350px, (min-width: 640px) 50vw, 100vw" eager={eager} />
    ) : (
      <span class="cover cover-empty" aria-hidden="true" />
    )
  }
  <div class="post-card-body">
    <Heading class="post-card-title">{title}</Heading>
    <p class="muted small">{description}</p>
    <p class="meta">
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      {author && <> · {author}</>}
    </p>
  </div>
</a>
