---
/**
 * A photograph from `src/content/site.ts` (`PHOTOS`, `GALLERY`): an Unsplash
 * id sized by Unsplash's CDN at several widths, or a `/images/…` file of your
 * own served as it is. `ratio` (height / width) crops it; `eager` for the one
 * photo at the top of a page, lazy everywhere else.
 */
import {type Photo as PhotoData, photo, photoSet} from '../content/site';

interface Props {
  photo: PhotoData;
  sizes: string;
  /** Height / width, e.g. 0.75 for 4:3. Omit to keep the photo's own shape. */
  ratio?: number;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const {photo: p, sizes, ratio, widths = [480, 800, 1200, 1600], eager = false, class: className} = Astro.props;
const width = widths.at(-1)!;
const height = Math.round(width * (ratio ?? 0.667));
const srcset = photoSet(p.src, widths, ratio);
---

<img
  class={className}
  src={photo(p.src, widths[1] ?? width, ratio ? Math.round((widths[1] ?? width) * ratio) : undefined)}
  srcset={srcset || undefined}
  sizes={srcset ? sizes : undefined}
  alt={p.alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
